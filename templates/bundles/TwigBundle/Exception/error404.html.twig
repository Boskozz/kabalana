{% extends 'base.html.twig' %}

{% block title %}Page introuvable - Alexandra Kabalan{% endblock %}

{% block body %}
	<div class="error-page">
		<img src="{{ asset('mandala/mandala-404.webp') }}" alt="" class="error-mandala">
		<h1 class="error-title">{{ status_code }}</h1>
		<p class="error-subtitle">Page non trouvée</p>
		<p class="error-message">La page que vous cherchez est introuvable ou a été déplacée.</p>
		<a href="{{ path('app_home') }}" class="btn btn-primary error-button">
			<i class="bi bi-house-door"></i>
			Retour à l'accueil
		</a>
	</div>
{% endblock %}
