{% set data = bloc.content|json_decode %}
{% set images = data.images|default([])|resolve_medias %}
{% set disposition = data.disposition|default('horizontal') %}

<div class="gallery {{ data.class|default('') }}" data-controller="lightbox">
    <div class="row g-4 justify-content-center">
        {% for image in images %}
            <div class="col-{% if disposition == 'horizontal' %}md-{{ 12 // images|length }}{% else %}12{% endif %}">
                <figure class="text-center">
                    <img src="{{ asset(image.url) }}"
                         alt="{{ image.alt|default('') }}"
                         class="{{ image.class|default('largeur-100') }}">
                    {% if image.legende %}
                        <figcaption>{{ image.legende }}</figcaption>
                    {% endif %}
                </figure>
            </div>
        {% endfor %}
    </div>
</div>